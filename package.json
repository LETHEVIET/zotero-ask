{
  "name": "zotero-ask",
  "type": "module",
  "version": "0.1.0",
  "description": "Chat with your documents in Zotero using AI",
  "config": {
    "addonName": "Zotero Ask",
    "addonID": "zoteroask@example.com",
    "addonRef": "zoteroask",
    "addonInstance": "ZoteroAsk",
    "prefsPrefix": "extensions.zotero.zoteroask"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letheviet/zotero-ask.git"
  },
  "author": "LetheViet",
  "bugs": {
    "url": "https://github.com/letheviet/zotero-ask/issues"
  },
  "homepage": "https://github.com/letheviet/zotero-ask#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "lucide": "^0.574.0",
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "marked": "^17.0.5",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.5",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
